    <string name="wk_glossary_title">What does it mean?</string>
    <string name="wk_glossary_set">Set: a block of repetitions in a row, then a rest. \"3 sets of 10\" = 10 reps, rest, three times.</string>
    <string name="wk_glossary_rep">Repetition (rep): doing the movement once, all the way.</string>
    <string name="wk_glossary_rest">Rest: the pause between sets, usually 1–2 minutes. Tap ✓ when you finish a set and the timer starts.</string>
    <string name="wk_glossary_effort">Effort: Easy = 4 or more reps left; Good = 2–3 left; Hard = 0–1 more.</string>
    <string name="wk_glossary_weight">Weight: the load you moved. Leave it empty for bodyweight exercises.</string>
