    <string name="wk_extras_warmup_title">Suggested warm-up</string>
    <string name="wk_extras_warmup_body">5–10 minutes before you start: raise your pulse, loosen up and wake up the muscles you will train today. Then do 1–2 lighter sets of your first exercise.</string>
    <string name="wk_extras_warmup_add">Add warm-up</string>
